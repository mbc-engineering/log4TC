{
  "AmsRouter": {
    // Activate AmsTcpIpRouter (Loopback without TC Installation)
    "Active": true,
    "Name": "Log4TcComputer",
    "NetId": "1.1.1.1.1.1",
    // Non Secure Port 48898
    "TcpPort": 48898,
    // Allowed values: "Loopback", "UnixSocket"
    "ChannelPortType": "Loopback",
    // Allowed values: "Ads" (use Loopback), "AdsOverMqtt" (Forces use of MQTT), "All" (First Loopback, then MQTT)
    "ChannelProtocol": "All",
    "RemoteConnections": [
      //{
      //  "Name": "RemoteSystem",
      //  "Address": "10.10.1.111",
      //  "NetId": "10.35.12.19.1.1",
      //  "Type": "TCP_IP"
      //}
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Outputs": [
    {
      "Type": "nlog"
    }
  ]
}
